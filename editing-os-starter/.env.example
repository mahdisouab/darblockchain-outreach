# Copy this file to .env and fill in your own keys.
# .env is gitignored. Never commit real keys.

# --- Optional: hosted transcription fallback --------------------------------
# No key is required. Transcription runs locally with whisper.cpp
# (scripts/transcribe-whisper.mjs). ElevenLabs Scribe is only the hosted
# fallback (scripts/transcribe-elevenlabs.mjs) if you would rather not run
# whisper on your machine. Get one at https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# --- Optional: b-roll providers (Agent 4 / insert-broll) --------------------
# Without these, insert-broll still works from your local asset-library/,
# it just cannot fetch new stock footage from the web.
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
